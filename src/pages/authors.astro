---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import { authors } from '../lib/library';

// A–Z by surname, like a card catalog.
const sorted = [...authors].sort((a, b) => a.sortName.localeCompare(b.sortName));
const letters = new Map<string, typeof sorted>();
for (const a of sorted) {
  const ch = a.sortName.normalize('NFKD').charAt(0).toUpperCase();
  const key = /[A-Z]/.test(ch) ? ch : '#';
  if (!letters.has(key)) letters.set(key, []);
  letters.get(key)!.push(a);
}
---

<Base title="Authors" description={`All ${authors.length} authors in the library, A–Z.`}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <header class="pt-10 sm:pt-14">
      <p class="eyebrow">Index</p>
      <h1 class="mt-2 text-4xl font-semibold sm:text-5xl">Authors</h1>
      <p class="mt-3 text-ink-2">All {authors.length} authors, sorted by surname.</p>
    </header>

    <nav aria-label="Jump to letter" class="sticky top-16 z-20 -mx-4 mt-6 border-b border-line bg-paper/95 px-4 py-2 backdrop-blur sm:-mx-6 sm:px-6">
      <ul class="flex gap-0.5 overflow-x-auto font-sans text-sm font-semibold">
        {
          [...letters.keys()].map((l) => (
            <li>
              <a href={`#letter-${l}`} class="grid size-8 place-items-center rounded text-ink-2 hover:bg-accent hover:text-on-accent">
                {l}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      [...letters].map(([l, list]) => (
        <section id={`letter-${l}`} class="scroll-mt-32 pt-8">
          <h2 class="rule text-3xl font-semibold text-accent">{l}</h2>
          <ul class="mt-4 columns-1 gap-8 sm:columns-2 lg:columns-3">
            {list.map((a) => (
              <li class="break-inside-avoid py-1">
                <a href={url(`/author/${a.slug}`)} class="group flex items-baseline gap-2">
                  <span class="font-display text-[1.05rem] group-hover:text-accent group-hover:underline">{a.name}</span>
                  <span class="flex-1 border-b border-dotted border-line" aria-hidden="true" />
                  <span class="font-sans text-sm tabular-nums text-ink-3">{a.books.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
