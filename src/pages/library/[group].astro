---
import { url } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ShelfRow from '../../components/ShelfRow.astro';
import ShelfPhoto from '../../components/ShelfPhoto.astro';
import { groups, type Group } from '../../lib/library';

export function getStaticPaths() {
  return groups.map((group) => ({ params: { group: group.slug }, props: { group } }));
}

const { group } = Astro.props as { group: Group };
const n = (v: number) => v.toLocaleString('en-US');
---

<Base title={group.name} description={`${n(group.totalBooks)} books across ${group.bookcases.length} bookcases at ${group.name}.`}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <header class="pt-10 sm:pt-14">
      <p class="eyebrow">Location</p>
      <h1 class="mt-2 text-4xl font-semibold sm:text-5xl">{group.name}</h1>
      <p class="mt-3 font-sans text-sm text-ink-3">
        {group.bookcases.length} bookcases · {group.totalShelves} shelves · {n(group.totalBooks)} books · {n(group.totalAuthors)} authors
      </p>
      <p class="mt-4 max-w-2xl text-ink-2">
        Pick a bookcase, then tap any spine to open that book. Shelves marked{" "}
        <Icon name="photo" class="inline size-4 align-[-2px]" /> have a photo of how they looked.
      </p>
    </header>

    <!-- Bookcase tabs (without JavaScript every bookcase is simply listed in order) -->
    <div class="sticky top-16 z-20 -mx-4 mt-8 border-b border-line bg-paper/95 px-4 backdrop-blur sm:-mx-6 sm:px-6">
      <div role="tablist" aria-label="Bookcases" class="flex gap-1 overflow-x-auto py-2" data-tabs>
        {
          group.bookcases.map((c, i) => (
            <a
              href={`#case-${c.id}`}
              role="tab"
              id={`tab-${c.id}`}
              aria-controls={`case-${c.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-tab={c.id}
              class="flex shrink-0 items-center gap-2 rounded-md px-3.5 py-2 font-sans text-sm font-medium text-ink-2 hover:bg-paper-2 hover:text-ink aria-selected:bg-accent aria-selected:text-on-accent"
            >
              {c.name}
              <span class="rounded-full bg-black/10 px-1.5 text-xs tabular-nums dark:bg-white/10">{c.totalBooks}</span>
            </a>
          ))
        }
      </div>
    </div>

    {
      group.bookcases.map((c) => (
        <section id={`case-${c.id}`} role="tabpanel" aria-labelledby={`tab-${c.id}`} data-panel={c.id} class="scroll-mt-32 pt-8">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-2xl font-semibold sm:text-3xl">{c.name} bookcase</h2>
            <p class="font-sans text-sm text-ink-3">
              {c.shelves.length} shelves · {n(c.totalBooks)} books
            </p>
          </div>

          <div class="mt-5 space-y-8">
            {c.shelves.map((s) => (
              <article id={`shelf-${s.id}`} class="card scroll-mt-36 overflow-hidden" data-shelf={s.id}>
                <div class="flex flex-wrap items-center justify-between gap-3 px-4 pb-3 pt-4 sm:px-5">
                  <div>
                    <h3 class="text-xl font-semibold">
                      Shelf {s.id}
                      {s.position && <span class="ml-1 font-sans text-sm font-normal text-ink-3">· {s.position}</span>}
                    </h3>
                    <p class="font-sans text-sm text-ink-3">
                      {s.books.length} books · {s.authors.length} authors
                    </p>
                  </div>
                  {s.photo && (
                    <button type="button" class="btn" data-open-photo={s.id}>
                      <Icon name="photo" class="size-4" /> Shelf photo
                    </button>
                  )}
                </div>

                <div class="px-2 sm:px-4">
                  <ShelfRow books={s.books} label={`Books on shelf ${s.id}`} />
                </div>

                <div class="px-4 pb-4 pt-4 sm:px-5">
                  <p class="eyebrow">Authors on this shelf</p>
                  <ul class="mt-2 flex flex-wrap gap-1.5">
                    {s.authors.map((a) => (
                      <li>
                        <a href={url(`/author/${a.slug}`)} class="chip hover:border-accent hover:text-accent">
                          {a.name}
                          {a.count > 1 && <span class="text-ink-3 tabular-nums">×{a.count}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>

                  <details class="group mt-4 border-t border-line pt-3">
                    <summary class="flex cursor-pointer list-none items-center gap-2 font-sans text-sm font-medium text-accent">
                      <span class="transition group-open:rotate-90" aria-hidden="true">›</span>
                      List all {s.books.length} books
                    </summary>
                    <ol class="mt-3 grid gap-x-8 gap-y-1.5 sm:grid-cols-2">
                      {s.books.map((b) => (
                        <li class="leading-snug">
                          <a href={url(`/books/${b.slug}`)} class="font-display hover:text-accent hover:underline">
                            {b.title}
                          </a>
                          <span class="font-sans text-sm text-ink-3"> — {b.author}</span>
                        </li>
                      ))}
                    </ol>
                  </details>
                </div>

                <ShelfPhoto shelf={s} caption={`${group.name} · ${c.name} bookcase · Shelf ${s.id}`} />
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<script>
  // Show one bookcase at a time. #case-X or #shelf-X3 in the URL picks (and scrolls to) the right one.
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];

  function select(id: string, focusTab = false) {
    for (const t of tabs) {
      const on = t.dataset.tab === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focusTab) t.focus();
      if (on) t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }
    for (const p of panels) p.hidden = p.dataset.panel !== id;
  }

  function fromHash() {
    const hash = decodeURIComponent(location.hash.slice(1));
    const target = hash ? document.getElementById(hash) : null;
    const panel = target?.closest<HTMLElement>('[data-panel]');
    select(panel?.dataset.panel ?? tabs[0]?.dataset.tab ?? '');
    if (target && target !== panel) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    if (target?.dataset.shelf) {
      target.classList.add('ring-2', 'ring-brass');
      setTimeout(() => target.classList.remove('ring-2', 'ring-brass'), 2400);
    }
  }

  tabs.forEach((t, i) => {
    t.addEventListener('click', (e) => {
      e.preventDefault();
      select(t.dataset.tab!);
      history.replaceState(null, '', `#case-${t.dataset.tab}`);
    });
    t.addEventListener('keydown', (e) => {
      const next = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
      if (next === null) return;
      e.preventDefault();
      const tab = tabs[(next + tabs.length) % tabs.length];
      select(tab.dataset.tab!, true);
      history.replaceState(null, '', `#case-${tab.dataset.tab}`);
    });
  });

  window.addEventListener('hashchange', fromHash);
  fromHash();
</script>
