---
import { url } from '../lib/url';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { fillText, groups, summary } from '../lib/library';
import { siteText } from '../site-text';

interface Props {
  title?: string;
  description?: string;
}

const name = siteText.siteName;
const { title, description = fillText(siteText.description) } = Astro.props;
const fullTitle = title ? `${title} · ${name}` : name;
const footerLeft = fillText(siteText.footer.left);
const footerRight = fillText(siteText.footer.right);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  ...groups.map((g) => ({ href: url(`/library/${g.slug}`), label: g.name })),
  { href: url('/authors'), label: 'Authors' },
  { href: url('/books/random'), label: 'Random' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const matomoUrl = import.meta.env.PUBLIC_MATOMO_URL ?? '';
const matomoSiteId = import.meta.env.PUBLIC_MATOMO_SITE_ID ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f4eee2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16110d" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/favicon/apple-touch-icon.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={url('/favicon/favicon-16x16.png')} />
    <link rel="manifest" href={url('/favicon/site.webmanifest')} />
    <link rel="shortcut icon" href={url('/favicon/favicon.ico')} />

    <!-- Apply the saved (or system) theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    <!-- Analytics: page views + events, no cookies. Only loads when Matomo env vars are set at build time. -->
    <script is:inline define:vars={{ matomoUrl, matomoSiteId }}>
      window._paq = window._paq || [];
      window.libTrack = (category, action, name) => window._paq.push(['trackEvent', category, action, name]);
      if (matomoUrl && matomoSiteId) {
        const u = matomoUrl.replace(/\/$/, '') + '/';
        window._paq.push(['disableCookies'], ['trackPageView'], ['enableLinkTracking'], ['setTrackerUrl', u + 'matomo.php'], ['setSiteId', matomoSiteId]);
        const s = document.createElement('script');
        s.async = true;
        s.src = u + 'matomo.js';
        document.head.appendChild(s);
      }
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 btn">Skip to content</a>

    <header class="sticky top-0 z-30 border-b border-line bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/75">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6">
        <a href={url('/')} class="group flex items-center gap-2.5 shrink-0" aria-label={`${name} — home`}>
          <span class="grid size-9 place-items-center rounded-md bg-accent text-on-accent shadow-sm">
            <Icon name="shelf" class="size-5" />
          </span>
          <span class="font-display text-xl font-semibold tracking-tight group-hover:text-accent">{name}</span>
        </a>

        <nav aria-label="Main" class="ml-4 hidden lg:block">
          <ul class="flex items-center gap-1 font-sans text-sm font-medium">
            {
              nav.map((n) => (
                <li>
                  <a
                    href={n.href}
                    aria-current={isActive(n.href) ? 'page' : undefined}
                    class="rounded-md px-3 py-2 text-ink-2 hover:bg-paper-2 hover:text-ink aria-[current=page]:text-accent aria-[current=page]:bg-paper-2"
                  >
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="ml-auto flex items-center gap-1.5">
          <button
            type="button"
            data-open-search
            class="flex h-10 items-center gap-2 rounded-md border border-line bg-card px-3 font-sans text-sm text-ink-3 hover:border-accent hover:text-ink sm:w-56 md:w-64"
            aria-label="Search the library"
          >
            <Icon name="search" class="size-[18px]" />
            <span class="hidden sm:inline">Search titles, authors…</span>
            <kbd class="ml-auto hidden rounded border border-line px-1.5 text-[0.7rem] text-ink-3 sm:inline">/</kbd>
          </button>
          <button type="button" data-theme-toggle class="grid size-10 place-items-center rounded-md text-ink-2 hover:bg-paper-2 hover:text-ink" aria-label="Toggle dark mode">
            <Icon name="moon" class="size-5 dark:hidden" />
            <Icon name="sun" class="hidden size-5 dark:block" />
          </button>
          <button
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="grid size-10 place-items-center rounded-md text-ink-2 hover:bg-paper-2 hover:text-ink lg:hidden"
            aria-label="Menu"
          >
            <Icon name="menu" class="size-6" />
          </button>
        </div>
      </div>

      <nav id="mobile-menu" aria-label="Main" class="hidden border-t border-line bg-paper lg:hidden" data-menu>
        <ul class="mx-auto max-w-6xl px-2 py-2 font-sans text-base font-medium">
          {
            nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  aria-current={isActive(n.href) ? 'page' : undefined}
                  class="block rounded-md px-3 py-3 text-ink-2 hover:bg-paper-2 aria-[current=page]:text-accent"
                >
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 font-sans text-sm text-ink-3 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>
          <span class="font-display text-base text-ink-2">{name}</span>
          {footerLeft && <span class="mx-1.5">·</span>}
          {footerLeft}
        </p>
        {footerRight && <p>{footerRight}</p>}
      </div>
    </footer>

    <!-- Search pop-up (shared by every page) -->
    <dialog
      id="search-dialog"
      class="mx-auto mt-[8vh] w-[min(40rem,calc(100vw-1.5rem))] max-h-[80dvh] overflow-hidden rounded-xl border border-line bg-card p-0 text-ink shadow-2xl"
      aria-label="Search the library"
    >
      <form action={url('/search')} method="get" class="flex items-center gap-3 border-b border-line px-4" role="search" data-search-form>
        <Icon name="search" class="size-5 shrink-0 text-ink-3" />
        <input
          name="q"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="Search titles, authors, publishers…"
          aria-label="Search"
          aria-controls="search-results"
          class="h-14 w-full bg-transparent font-sans text-base text-ink outline-none placeholder:text-ink-3 focus-visible:outline-none"
          data-search-input
        />
        <button type="button" class="btn !px-2 !py-1 text-xs" data-close-search>Esc</button>
      </form>
      <div class="max-h-[calc(80dvh-3.5rem)] overflow-y-auto" id="search-results" data-search-results aria-live="polite">
        <p class="px-5 py-8 text-center font-sans text-sm text-ink-3">Type at least two letters to search {summary.totalBooks.toLocaleString('en-US')} books.</p>
      </div>
    </dialog>

    <script>
      import '../scripts/site';
      import '../scripts/search-dialog';
    </script>
  </body>
</html>
